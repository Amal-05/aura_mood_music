rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile Rules ---
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string
        && (data.get('streak', 0) is int)
        && (data.get('level', 1) is int);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming())
        && incoming().keys().hasAll(['uid', 'email'])
        && incoming().keys().size() >= 2;
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'level', 'streak', 'totalListeningMinutes', 'harmonyScore', 'lastActiveAt']);
    }

    // --- Mood Log Rules ---
    function isValidMoodLog(data) {
      return data.userId == request.auth.uid
        && data.moodType is string
        && data.energyValue is int
        && data.energyValue >= 0 && data.energyValue <= 100
        && data.createdAt == request.time;
    }

    match /mood_logs/{logId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
